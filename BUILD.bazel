shared_test(
    name = "integration-tests",
    timeout = "long",
    args = [
        "--skip",
        "gnu",
    ],
    binary = ":integration-binary",
    libraries = [
        "@peios_sdk//:library",
        "@peios_sdk//:auth-library",
    ],
    tags = [
        "external",
        "no-remote",
    ],
    utility = ":peiosutils",
)

genrule(
    name = "stdbuf-runtime",
    srcs = ["//src/uu/stdbuf/src/libstdbuf:library"],
    outs = ["libstdbuf.so"],
    cmd = "cp $< $@",
)

filegroup(
    name = "package-data",
    srcs = [
        "Cargo.lock",
        "Cargo.toml",
        "LICENSE",
        "NOTICE",
        ":all-locales",
        "//include:sources",
        "//packages:definitions",
    ] + glob([
        "third-party/**",
        "docs/man/*.3",
        "docs/man/*.inc",
    ]),
)

filegroup(
    name = "package-sources",
    srcs = [
        ":all-sources",
        "//build/feature-set:sources",
        "//include:sources",
        "//packages:sources",
        "//tests/abi:sources",
    ],
)

package_store(
    name = "packages",
    packages = ["//packages:all"],
)

host_test(
    name = "generated-targets-test",
    command = 'exec python3 tools/bazel-targets.py --check --buildifier "$BUILDIFIER"',
    data = [":all-sources"],
    tags = [
        "external",
        "no-remote",
    ],
    tools = {"@buildifier//file": "BUILDIFIER"},
)

locale_tree(
    name = "locales-runtime",
    srcs = [":all-locales"],
)

exports_files([".clippy.toml"])
