load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load("//build:checks.bzl", "shared_test")

cc_binary(
    name = "c-binary",
    srcs = ["libraries.c"],
    copts = [
        "-std=c11",
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
    tags = ["manual"],
    deps = [
        "//crates/libevman:link",
        "//crates/libreg:link",
        "//crates/libregman:link",
        "//include:headers",
    ],
)

shared_test(
    name = "c-tests",
    binary = ":c-binary",
    libraries = [
        "//crates/libreg:soname",
        "//crates/libregman:soname",
        "//crates/libevman:soname",
        "@peios_sdk//:library",
    ],
)

cc_library(
    name = "cpp-headers",
    srcs = ["headers.cc"],
    copts = [
        "-std=c++17",
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
    deps = ["//include:headers"],
)

filegroup(
    name = "sources",
    srcs = [
        "BUILD.bazel",
        "headers.cc",
        "libraries.c",
    ],
    visibility = ["//visibility:public"],
)
